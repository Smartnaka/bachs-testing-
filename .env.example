# Public URL used for Bachs redirect callbacks. Must be HTTPS outside local development.
APP_BASE_URL=http://localhost:3000

# Server-only Bachs credentials and API endpoints. Do not prefix these with a client/public prefix.
BACHS_API_KEY=replace_with_your_bachs_api_key
BACHS_API_BASE_URL=https://replace-with-bachs-api-host
BACHS_INITIALIZE_PATH=/v1/checkout-sessions
BACHS_VERIFY_PATH=/v1/checkout-sessions/{id}
BACHS_PRODUCT_ID=prod_abc123

# Configure this if Bachs signs webhook payloads. The server expects an HMAC-SHA256
# signature in x-bachs-signature (or x-webhook-signature).
BACHS_WEBHOOK_SECRET=replace_with_your_bachs_webhook_secret
